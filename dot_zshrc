# =========================================
# Powerlevel10k Instant Prompt
# =========================================
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# =========================================
# Oh My Zsh
# =========================================
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"
DISABLE_CORRECTION="true"
plugins=(git zsh-autosuggestions zsh-syntax-highlighting)
[[ -r "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"

# =========================================
# Enable colors for ls
# =========================================
autoload -U colors && colors
alias ls='ls --color=auto --group-directories-first'
alias ll='ls -alFh --color=auto --group-directories-first'
alias la='ls -A --color=auto --group-directories-first'
alias l='ls -CF --color=auto --group-directories-first'

# =========================================
# Powerlevel10k config
# =========================================
[[ -r "$HOME/.p10k.zsh" ]] && source "$HOME/.p10k.zsh"

# =========================================
# Only wrap commands with grc configs (but skip ls)
# =========================================
if [[ -d /usr/share/grc ]] && command -v grc >/dev/null 2>&1; then
  for config in /usr/share/grc/conf.*(N); do
    cmd=${config:t}
    cmd=${cmd#conf.}
    case "$cmd" in
      ls|l|la) continue ;;
    esac
    command -v "$cmd" >/dev/null 2>&1 && alias "$cmd"="grc $cmd"
  done
fi


# This ensures only commands that exist in grc configs are wrapped
# Unknown commands will fall back to Zsh’s default behavior (apt suggestions work!)

export EDITOR=nvim
export VISUAL=nvim

# Make autosuggestions readable
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#7c6f64'
# or a bit brighter:
# ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#928374'
# or strongest (still not ugly):
# ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#a89984'

export PATH="$HOME/.local/bin:$HOME/.pyenv/bin:$PATH"
if command -v pyenv >/dev/null 2>&1; then
  eval "$(pyenv init - zsh)"
  eval "$(pyenv virtualenv-init -)"
fi

if [[ -r "$HOME/miniconda3/etc/profile.d/conda.sh" ]]; then
  source "$HOME/miniconda3/etc/profile.d/conda.sh"
fi




export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion
