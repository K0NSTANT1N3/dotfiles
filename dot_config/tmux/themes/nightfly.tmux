# Nightfly Theme Palette (Matched to Ghostty/WezTerm)
tmux_conf_theme_colour_1="#011627"    # Background
tmux_conf_theme_colour_2="#65737e"    # Inactive borders / muted gray
tmux_conf_theme_colour_3="#c0caf5"    # Soft foreground text
tmux_conf_theme_colour_4="#82aaff"    # Primary Accent (Active Window - Blue)
tmux_conf_theme_colour_5="#ffca3a"    # Yellow Accent
tmux_conf_theme_colour_6="#011627"    
tmux_conf_theme_colour_7="#c0caf5"    # Foreground Text
tmux_conf_theme_colour_8="#011627"    
tmux_conf_theme_colour_9="#ffca3a"    # Yellow Accent
tmux_conf_theme_colour_10="#c792ea"   # Purple Accent
tmux_conf_theme_colour_11="#7fdbca"   # Cyan/Teal Accent
tmux_conf_theme_colour_12="#0e2233"   # Status bar bg (shade of colour_1 #011627)

# Status Bar & Windows
tmux_conf_theme_status_bg="#0e2233"
tmux_conf_theme_status_fg="#c0caf5"
tmux_conf_theme_status_attr="none"
tmux_conf_theme_window_status_current_bg="#82aaff"
tmux_conf_theme_window_status_current_fg="#011627"
tmux_conf_theme_window_status_current_attr="bold"
tmux_conf_theme_window_status_bg="#011627"
tmux_conf_theme_window_status_fg="#65737e"
tmux_conf_theme_window_status_attr="none"

# Active & Inactive Pane Borders
tmux_conf_theme_pane_border_fg="#1d3b53"
tmux_conf_theme_pane_active_border_fg="#82aaff"

# Text Selection / Copy Mode Highlight (Fixes the sharp yellow!)
tmux_conf_theme_mode_bg="#1d3b53"
tmux_conf_theme_mode_fg="default"
tmux_conf_theme_mode_attr="none"

tmux_conf_theme_clock_colour="#ffffff"

tmux_conf_theme_status_left=' ❐ #S '
tmux_conf_theme_status_left_fg="#011627"
tmux_conf_theme_status_left_bg="#c792ea"
tmux_conf_theme_status_left_attr="bold"
tmux_conf_theme_status_right=' %H:%M | %d %b '
tmux_conf_theme_status_right_fg="#011627,#011627"
tmux_conf_theme_status_right_bg="#ffca3a,#7fdbca"
tmux_conf_theme_status_right_attr="bold,bold"

tmux_conf_theme_message_fg="#c0caf5"
tmux_conf_theme_message_bg="#0e2233"
tmux_conf_theme_message_attr="bold"
tmux_conf_theme_message_command_fg="#c0caf5"
tmux_conf_theme_message_command_bg="#0e2233"
tmux_conf_theme_message_command_attr="bold"
