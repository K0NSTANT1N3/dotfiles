# Groovbuddy Theme Palette (Matched to Ghostty/WezTerm)
tmux_conf_theme_colour_1="#14110e"    # Background
tmux_conf_theme_colour_2="#3c2f2a"    # Inactive borders / dark brown
tmux_conf_theme_colour_3="#ebdbb2"    # Soft foreground text
tmux_conf_theme_colour_4="#83a598"    # Primary Accent (Active Window - Blue)
tmux_conf_theme_colour_5="#fabd2f"    # Yellow Accent
tmux_conf_theme_colour_6="#14110e"    
tmux_conf_theme_colour_7="#ebdbb2"    # Foreground Text
tmux_conf_theme_colour_8="#14110e"    
tmux_conf_theme_colour_9="#fe8019"    # Orange Accent
tmux_conf_theme_colour_10="#d3869b"   # Magenta Accent
tmux_conf_theme_colour_11="#b8bb26"   # Green Accent
tmux_conf_theme_colour_12="#28201a"   # Status bar bg (shade of colour_1 #14110e)

tmux_conf_theme_status_bg="#28201a"
tmux_conf_theme_status_fg="#ebdbb2"
tmux_conf_theme_status_attr="none"
tmux_conf_theme_window_status_bg="#28201a"
tmux_conf_theme_window_status_fg="#a89984"
tmux_conf_theme_window_status_attr="none"
tmux_conf_theme_pane_active_border_fg="#fe8019"
tmux_conf_theme_mode_bg="#3c2f2a"
tmux_conf_theme_mode_fg="default"
tmux_conf_theme_mode_attr="none"
tmux_conf_theme_clock_colour="#ffffff"

tmux_conf_theme_status_left=' ❐ #S '
tmux_conf_theme_status_left_fg="#14110e"
tmux_conf_theme_status_left_bg="#d3869b"
tmux_conf_theme_status_left_attr="bold"
tmux_conf_theme_window_status_current_bg="#fe8019"
tmux_conf_theme_window_status_current_fg="#14110e"
tmux_conf_theme_window_status_current_attr="bold"
tmux_conf_theme_status_right=' %H:%M | %d %b '
tmux_conf_theme_status_right_fg="#14110e,#14110e"
tmux_conf_theme_status_right_bg="#fabd2f,#b8bb26"
tmux_conf_theme_status_right_attr="bold,bold"

tmux_conf_theme_message_fg="#ebdbb2"
tmux_conf_theme_message_bg="#28201a"
tmux_conf_theme_message_attr="bold"
tmux_conf_theme_message_command_fg="#ebdbb2"
tmux_conf_theme_message_command_bg="#28201a"
tmux_conf_theme_message_command_attr="bold"
